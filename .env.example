# ============================================
# TeslaMate Dashboard - 环境变量模板
# ============================================
# 1. 复制本文件为 .env:   cp .env.example .env
# 2. 填入你的真实配置
# 3. .env 文件已被 .gitignore 忽略，不会上传到 GitHub
# ============================================

# PostgreSQL 连接配置（从 Railway TeslaMate 项目的 Postgres 服务获取）
DATABASE_HOST=your-postgres-host.railway.app
DATABASE_PORT=5432
DATABASE_NAME=railway
DATABASE_USER=postgres
DATABASE_PASS=your-password-here

# Railway PostgreSQL 通常需要 SSL
DATABASE_SSL=true

# 服务端口（Railway 会自动注入 PORT，本地开发时默认 3000）
PORT=3000
